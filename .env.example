PORT=3000
OPENROUTER_API_KEY=your_openrouter_key_here
DEFAULT_MODEL=deepseek/deepseek-chat

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/parse_for_agents

# Redis (required for rate limiting and result caching)
REDIS_URL=redis://localhost:6379

# API Keys
MASTER_API_KEY=pfa_master_your_secret_here
DEMO_API_KEY=

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://parse-for-agents-production.up.railway.app

# Key generation (set to false to disable self-service key creation)
KEY_GENERATION_ENABLED=true

# Sandbox Execution (isolated LLM execution)
SANDBOX_URL=https://parse-sandbox-production.up.railway.app
SANDBOX_HMAC_SECRET=your_hmac_secret_here
ALLOW_UNISOLATED_EXECUTION=false

# x402 Payment Configuration (agent-to-agent USDC payments)
X402_ENABLED=false
X402_PAY_TO_ADDRESS=0x_your_base_wallet_address
X402_FACILITATOR_URL=https://facilitator.x402.org
X402_NETWORK=eip155:8453
