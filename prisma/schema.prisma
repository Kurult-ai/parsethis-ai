generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ApiKey {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  orgId      String?  @map("org_id")
  keyHash    String   @unique @map("key_hash")
  keyPrefix  String   @map("key_prefix")
  name       String
  tier       String   @default("free")
  scopes     String[] @default(["evaluate"])
  rateLimit  Int      @default(10) @map("rate_limit")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  evaluations      Evaluation[]
  usageRecords     UsageRecord[]
  screeningPolicy  ScreeningPolicy?
  screeningEvents  ScreeningEvent[]
  subscription     Subscription?
  billingUsage     BillingUsage[]
  entitlementGrants EntitlementGrant[]
  supportTickets   SupportTicket[]
  adminReceipts    AdminActionReceipt[]
  organization     Organization? @relation(fields: [orgId], references: [id])

  @@map("api_keys")
}

model Evaluation {
  id          String   @id
  apiKeyId    String   @map("api_key_id")
  status      String   @default("queued")
  prompt      String
  model       String
  variables   Json?
  testCases   Json     @map("test_cases")
  evaluators  String[]
  config      Json     @default("{}")
  results     Json?
  summary     Json?
  error       Json?
  createdAt   DateTime @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime? @map("expires_at")

  apiKey       ApiKey        @relation(fields: [apiKeyId], references: [id])
  usageRecords UsageRecord[]

  @@index([status], name: "idx_evaluations_status")
  @@index([apiKeyId], name: "idx_evaluations_api_key")
  @@index([createdAt(sort: Desc)], name: "idx_evaluations_created")
  @@map("evaluations")
}

model UsageRecord {
  id              String   @id @default(cuid())
  apiKeyId        String   @map("api_key_id")
  evaluationId    String   @map("evaluation_id")
  model           String
  inputTokens     Int      @map("input_tokens")
  outputTokens    Int      @map("output_tokens")
  costUsd         Decimal  @map("cost_usd") @db.Decimal(10, 6)
  evaluatorCostUsd Decimal @default(0) @map("evaluator_cost_usd") @db.Decimal(10, 6)
  createdAt       DateTime @default(now()) @map("created_at")

  apiKey     ApiKey     @relation(fields: [apiKeyId], references: [id])
  evaluation Evaluation @relation(fields: [evaluationId], references: [id])

  @@index([apiKeyId, createdAt(sort: Desc)], name: "idx_usage_api_key_created")
  @@map("usage_records")
}

model ScreeningPolicy {
  id        String   @id @default(uuid())
  apiKeyId  String   @unique @map("api_key_id")
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  // Structural triggers (agents can evaluate mechanically)
  screenUserInput        Boolean @default(true)   @map("screen_user_input")
  screenToolOutputs      Boolean @default(true)   @map("screen_tool_outputs")
  screenForwardedMessages Boolean @default(true)  @map("screen_forwarded_messages")
  screenAllPrompts       Boolean @default(false)  @map("screen_all_prompts")

  // Action thresholds (tier-enforced minimums)
  autoBlockThreshold     Int     @default(7)      @map("auto_block_threshold")
  executeInSandbox       Boolean @default(true)   @map("execute_in_sandbox")
  agentSafe              Boolean @default(false)  @map("agent_safe")
  bypassEnabled          Boolean @default(false)  @map("bypass_enabled")
  bypassCodewordHash     String?                  @map("bypass_codeword_hash")
  bypassExpiresAt        DateTime?                @map("bypass_expires_at")

  // Enforcement dial: "monitor" | "warn" | "block"
  // monitor = full pipeline runs, verdicts recorded, nothing blocked (counterfactual)
  // warn    = verdict annotation returned but not blocked
  // block   = dangerous content is actually blocked (current behavior)
  enforcementMode        String   @default("block") @map("enforcement_mode")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("screening_policies")
}

model ScreeningEvent {
  id         String   @id @default(cuid())
  apiKeyId   String   @map("api_key_id")
  riskScore  Float    @map("risk_score")
  verdict    String
  categories String[]
  mode       String   @default("full")
  latencyMs  Int      @map("latency_ms")
  blocked    Boolean  @default(false)
  wouldBlock Boolean? @map("would_block")
  enforcementMode String? @map("enforcement_mode")
  metadata   Json?    @map("metadata")
  createdAt  DateTime @default(now()) @map("created_at")

  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId, createdAt(sort: Desc)], name: "idx_screening_apikey_created")
  @@index([createdAt(sort: Desc)], name: "idx_screening_created")
  @@index([verdict], name: "idx_screening_verdict")
  @@map("screening_events")
}

model AuditEvent {
  id        String   @id @default(cuid())
  action    String
  apiKeyId  String?  @map("api_key_id")
  detail    String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action], name: "idx_audit_action")
  @@index([createdAt(sort: Desc)], name: "idx_audit_created")
  @@map("audit_events")
}

model PaymentRecord {
  id        String   @id @default(cuid())
  txHash    String   @unique @map("tx_hash")
  payer     String
  amount    Decimal  @db.Decimal(18, 6)
  endpoint  String
  depth     String?
  network   String   @default("eip155:8453")
  status    String   @default("settled")
  timestamp DateTime @default(now())

  @@index([payer], name: "idx_payments_payer")
  @@index([timestamp(sort: Desc)], name: "idx_payments_timestamp")
  @@map("payment_records")
}

model Subscription {
  id                    String   @id @default(cuid())
  apiKeyId              String   @unique @map("api_key_id")
  stripeCustomerId      String   @unique @map("stripe_customer_id")
  stripeSubscriptionId  String   @unique @map("stripe_subscription_id")
  stripePriceId         String   @map("stripe_price_id")
  status                String   @default("active")
  currentPeriodStart    DateTime @map("current_period_start")
  currentPeriodEnd      DateTime @map("current_period_end")
  cancelAtPeriodEnd     Boolean  @default(false) @map("cancel_at_period_end")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([status], name: "idx_subscriptions_status")
  @@map("subscriptions")
}

model BillingUsage {
  id              String   @id @default(cuid())
  apiKeyId        String   @map("api_key_id")
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  requestCount    Int      @default(0) @map("request_count")
  overageCount    Int      @default(0) @map("overage_count")
  reportedToStripe Boolean @default(false) @map("reported_to_stripe")
  createdAt       DateTime @default(now()) @map("created_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, periodStart], name: "idx_billing_usage_key_period")
  @@map("billing_usage")
}

model EntitlementGrant {
  id              String   @id @default(cuid())
  apiKeyId        String   @map("api_key_id")
  userId          String   @map("user_id")
  tier            String
  reason          String
  grantedBy       String   @map("granted_by")
  priceMode       String   @default("manual") @map("price_mode")
  priceUsdCents   Int?     @map("price_usd_cents")
  stripePriceId   String?  @map("stripe_price_id")
  startsAt        DateTime @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  expireKeyAtEnd  Boolean  @default(false) @map("expire_key_at_end")
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, status], name: "idx_entitlement_grants_key_status")
  @@index([userId], name: "idx_entitlement_grants_user")
  @@index([endsAt], name: "idx_entitlement_grants_ends")
  @@map("entitlement_grants")
}

model SupportTicket {
  id               String   @id @default(cuid())
  source           String
  externalId       String?  @map("external_id")
  requesterEmail   String?  @map("requester_email")
  requesterName    String?  @map("requester_name")
  subject          String?
  body             String
  status           String   @default("open")
  priority         String   @default("normal")
  category         String?
  apiKeyId         String?  @map("api_key_id")
  stripeCustomerId String?  @map("stripe_customer_id")
  assignedTo       String?  @map("assigned_to")
  summary          String?
  resolution       String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  resolvedAt       DateTime? @map("resolved_at")

  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  messages SupportMessage[]
  receipts AdminActionReceipt[]

  @@index([status, priority], name: "idx_support_tickets_status_priority")
  @@index([requesterEmail], name: "idx_support_tickets_requester")
  @@index([apiKeyId], name: "idx_support_tickets_api_key")
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String   @map("ticket_id")
  direction  String
  channel    String
  externalId String?  @map("external_id")
  from       String?
  to         String?
  body       String
  screened   Boolean  @default(false)
  riskScore  Float?   @map("risk_score")
  verdict    String?
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt], name: "idx_support_messages_ticket_created")
  @@map("support_messages")
}

model AdminActionReceipt {
  id             String   @id @default(cuid())
  action         String
  actor          String
  ticketId       String?  @map("ticket_id")
  apiKeyId       String?  @map("api_key_id")
  userId         String?  @map("user_id")
  stripeObjectId String?  @map("stripe_object_id")
  reason         String?
  dryRun         Boolean  @default(false) @map("dry_run")
  before         Json?
  after          Json?
  result         Json?
  riskLevel      String   @default("low") @map("risk_level")
  approvalState  String   @default("not_required") @map("approval_state")
  createdAt      DateTime @default(now()) @map("created_at")

  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  ticket SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([action, createdAt], name: "idx_admin_receipts_action_created")
  @@index([ticketId], name: "idx_admin_receipts_ticket")
  @@index([apiKeyId], name: "idx_admin_receipts_api_key")
  @@map("admin_action_receipts")
}

model AdminImprovementProposal {
  id                 String    @id @default(cuid())
  idempotencyKey     String    @unique @map("idempotency_key")
  title              String
  category           String    @default("saas_readiness")
  priority           Int       @default(5)
  status             String    @default("proposed")
  riskLevel          String    @default("low") @map("risk_level")
  source             String    @default("hourly_improvement_loop")
  evidence           Json?
  impact             String?
  acceptanceCriteria Json?     @map("acceptance_criteria")
  taskTitle          String?   @map("task_title")
  taskBody           String?   @map("task_body")
  taskAssignee       String    @default("triage") @map("task_assignee")
  taskId             String?   @map("task_id")
  taskCreatedAt      DateTime? @map("task_created_at")
  approvedBy         String?   @map("approved_by")
  approvedAt         DateTime? @map("approved_at")
  approvalSource     String?   @map("approval_source")
  rejectionReason    String?   @map("rejection_reason")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([status, priority, createdAt], name: "idx_admin_improvement_proposals_status_priority_created")
  @@map("admin_improvement_proposals")
}

// ─── Compliance Expansion Layer ─────────────────────────────────────────
// Audit-first design: every agent action is traceable to an org, an agent,
// a policy, and a framework control.

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  ownerId     String   @map("owner_id")
  planTier    String   @default("free") @map("plan_tier")
  ssoEnabled  Boolean  @default(false) @map("sso_enabled")
  ssoConfig   Json?    @map("sso_config")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  apiKeys     ApiKey[]
  agents      AgentRegistry[]
  siemConfigs SIEMConfig[]
  exports     ComplianceExport[]
  policyHistory PolicyRevision[]

  @@map("organizations")
}

model AgentRegistry {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  agentName     String   @map("agent_name")
  agentVersion  String?  @map("agent_version")
  framework     String?  // langchain, crewai, autogen, openai-assistants, custom
  description   String?
  tools         String[] @default([])    // MCP servers, APIs, plugins this agent can use
  dataAccess    String[] @default([])    // data classifications: public, internal, confidential, restricted
  riskLevel     String   @default("medium") @map("risk_level")  // low, medium, high, critical
  status        String   @default("active")  // active, suspended, decommissioned
  ownerEmail    String?  @map("owner_email")
  deployedAt    DateTime? @map("deployed_at")
  lastSeenAt    DateTime? @map("last_seen_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status], name: "idx_agent_registry_org_status")
  @@index([orgId, riskLevel], name: "idx_agent_registry_org_risk")
  @@map("agent_registry")
}

model PolicyRevision {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  version       Int      @default(1)
  policySnapshot Json    @map("policy_snapshot")
  changedBy     String   @map("changed_by")
  changeReason  String?  @map("change_reason")
  diff          Json?    // structured diff from previous version
  createdAt     DateTime @default(now()) @map("created_at")

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)], name: "idx_policy_revisions_org_created")
  @@unique([orgId, version], name: "idx_policy_revisions_org_version")
  @@map("policy_revisions")
}

model SIEMConfig {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  platform      String   // splunk, datadog, elastic, sentinel, generic_webhook
  endpoint      String
  authHeader    String?  @map("auth_header")  // stored encrypted at rest
  format        String   @default("cef")  // cef, json, leef, raw
  eventTypes    String[] @default(["screening", "audit", "policy_change", "approval"])
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, active], name: "idx_siem_configs_org_active")
  @@map("siem_configs")
}

model ComplianceExport {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  requestedBy   String   @map("requested_by")
  status        String   @default("pending")  // pending, generating, ready, failed, expired
  framework     String   @default("all")  // owasp-llm, nist-ai-rmf, eu-ai-act, soc2, iso-42001, all
  dateFrom      DateTime @map("date_from")
  dateTo        DateTime @map("date_to")
  format        String   @default("json")  // json, csv, pdf
  artifactUrl   String?  @map("artifact_url")
  artifactHash  String?  @map("artifact_hash")  // SHA-256 of the export for tamper evidence
  eventCount    Int?     @map("event_count")
  sizeBytes     Int?     @map("size_bytes")
  error         String?
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)], name: "idx_compliance_exports_org_created")
  @@index([status], name: "idx_compliance_exports_status")
  @@map("compliance_exports")
}
