{
  "name": "parse-for-agents",
  "version": "1.0.0",
  "description": "Parse Agents - prompt protection API for AI agents with MCP and x402",
  "type": "module",
  "workspaces": [
    "packages/prompt-guard",
    "packages/mcp-prompt-guard"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "worker": "tsx src/worker.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "agents",
    "prompt-protection",
    "prompt-injection",
    "mcp",
    "x402",
    "media-analysis",
    "credibility",
    "ai"
  ],
  "author": "Kurultai",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@coinbase/x402": "^2.1.0",
    "@hono/node-server": "^1.19.11",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@x402/core": "^2.5.0",
    "@x402/evm": "^2.5.0",
    "@x402/hono": "^2.5.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.70.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.5",
    "ioredis": "^5.10.0",
    "marked": "^17.0.5",
    "openai": "^6.27.0",
    "pg": "^8.20.0",
    "prisma": "^7.4.2",
    "stripe": "^22.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
