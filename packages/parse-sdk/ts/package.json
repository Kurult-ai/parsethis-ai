{
  "name": "@parsethis/sdk",
  "version": "0.1.3",
  "description": "Drop-in interceptor that screens every OpenAI/Anthropic client call with Parse prompt security.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/hermes-middleware": {
      "types": "./dist/adapters/hermes-middleware.d.ts",
      "import": "./dist/adapters/hermes-middleware.js",
      "default": "./dist/adapters/hermes-middleware.js"
    },
    "./adapters/openclaw-plugin": {
      "types": "./dist/adapters/openclaw-plugin.d.ts",
      "import": "./dist/adapters/openclaw-plugin.js",
      "default": "./dist/adapters/openclaw-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "parse",
    "prompt-injection",
    "prompt-security",
    "ai-safety",
    "openai",
    "anthropic",
    "llm",
    "agents"
  ],
  "author": "Kurultai",
  "license": "ISC",
  "homepage": "https://www.parsethis.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kurult-ai/parsethis-ai.git",
    "directory": "packages/parse-sdk/ts"
  },
  "bugs": {
    "url": "https://github.com/Kurult-ai/parsethis-ai/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
